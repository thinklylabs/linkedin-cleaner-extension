{
  "manifest_version": 3,
  "name": "Authr Extension",
  "version": "1.0.1",
  "description": "Clean your LinkedIn feed to see only the content you want to see.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/feed/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:3000/*",
    "https://authr-ai.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://authr-ai.com/*"
    ]
  },
  "content_scripts": [
    {
      "js": [
        "scripts/config.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.linkedin.com/feed/*"
      ]
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Authr Extension"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}