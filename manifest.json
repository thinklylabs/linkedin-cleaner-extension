{
  "manifest_version": 3,
  "name": "authr",
  "version": "1.0.0",
  "description": "Clean your LinkedIn feed with AI-powered filtering",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/feed/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "scripts/config.js",
        "scripts/content.js"
      ],
      "matches": [
        "https://www.linkedin.com/feed/*"
      ]
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "authr"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
